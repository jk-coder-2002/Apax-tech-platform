# Duplicate this file as .env in server/ and fill in real values for local development.
# Never commit the real .env file.

# HTTP port
PORT=4000

# Environment
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/apax

# JWT secret and expiry (no default — the server refuses to boot without a real secret)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

# Cookie expiry, in days
COOKIE_EXPIRE=7


# Cloudinary credentials (used by avatar upload in registerUser/updateProfile)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sendgrid credentials (used by forgotPassword email)
SENDGRID_API_KEY=
SENDGRID_MAIL=
SENDGRID_RESET_TEMPLATEID=
