# Duplicate this file as .env.local in web/ to override the default.

# The backend's URL, called directly from the browser. Defaults to
# http://localhost:4000 if unset - fine for local dev, where frontend and
# backend share the "localhost" domain so the auth cookie works either way.
#
# In a deployed environment where frontend and backend are on different
# domains (e.g. Vercel + Render), set this to an EMPTY string instead - not
# unset, empty - so requests go to this app's own origin and get proxied to
# BACKEND_URL below (see next.config.mjs's rewrites and the README's
# Deployment section for why: a direct cross-domain cookie gets blocked by
# browsers as third-party, even with SameSite=None).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Only used by the rewrite proxy in next.config.mjs - read server-side only,
# never sent to the browser (no NEXT_PUBLIC_ prefix). Only needed when
# NEXT_PUBLIC_API_URL above is set to empty.
BACKEND_URL=
